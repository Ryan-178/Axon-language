# Self-hosting stage-4 first slice: the Aoxn code generator (written in Aoxn)
# runs after the self-hosted checker and emits a native object file via the
# LLVM-C API. Run from a writable directory: it writes selfhost_out.obj.
#
# Covered: int/void functions, int locals, arithmetic + comparisons, if/else,
# while, for-range, break/continue, direct and monomorphized calls.
import "../stdlib/stdlib.ax"
import "lexer.ax"
import "parser.ax"
import "typecheck.ax"
import "codegen.ax"

def main() -> int:
    src = "def twice[T](x: T) -> T:\n    return x + x\n\ndef add(a: int, b: int) -> int:\n    return a + b\n\ndef fact(n: int) -> int:\n    if n <= 1:\n        return 1\n    return n * fact(n - 1)\n\ndef main() -> int:\n    t = twice(3)\n    for i in range(1, 6):\n        t = t + i * i\n    while t > 50:\n        t = t - 10\n    return add(t, fact(4)) % 100\n"
    c = checker_new(lex_state_new(src))
    c = check_all(c)
    if c.err == 1:
        print("CHECK ERROR: " + c.errmsg)
        return 1
    g = gen_new(c)
    g = gen_program(g)
    if g.err == 1:
        print("CODEGEN ERROR: " + g.errmsg)
        return 1
    g = gen_emit_object(g, "selfhost_out.obj")
    if g.err == 1:
        print("EMIT ERROR: " + g.errmsg)
        return 1
    gen_dispose(g)
    print("codegen OK")
    return 0
