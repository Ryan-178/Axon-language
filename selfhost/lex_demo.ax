# Self-hosting stage-1 demo: the Aoxn lexer (written in Aoxn) tokenizes a
# sample program. This is the dress rehearsal for the self-hosted compiler.
import "../stdlib/stdlib.ax"
import "lexer.ax"

def main() -> int:
    src = "def main() -> int:\n    # greet\n    x = 1\n    print(\"hi\", 2.5)\n    return x\n"

    st = lex_all(lex_state_new(src))
    i = 0
    while i < st.kinds.len:
        k = tk_kind(st, i)
        name = kind_name(k)
        s = tk_sval(st, i)
        if s == "":
            print(name)
        else:
            print(name + " " + s)
        i = i + 1
    return 0
