# Prime counting via trial division (no arrays yet in v0.2)
def is_prime(n: int) -> bool:
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d = d + 1
    return True

def main() -> int:
    count = 0
    n = 2
    while n < 100000:
        if is_prime(n):
            count = count + 1
        n = n + 1
    print(count)
    return 0
