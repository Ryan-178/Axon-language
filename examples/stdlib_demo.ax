# Standard library demo — compile with: axon run examples/stdlib_demo.ax stdlib/stdlib.ax
def main() -> int:
    # math
    print(isqrt(99))
    print(pow_i(2, 10))
    print(gcd(48, 18))
    print(is_prime(97))
    print(hypot(3.0, 4.0))

    # sort / search (value semantics: sort returns a copy)
    arr = [5, 3, 8, 1, 9, 2, 7, 4]
    sorted_arr = bubble_sort_8(arr)
    print(arr[0])                          # 5 — input untouched
    print(binary_search_8(sorted_arr, 8))  # index of 8 in sorted copy
    print(sum_8(arr))
    print(max_8(arr))
    print(linear_search_8(reverse_8(arr), 9))

    # f-strings work with library results too
    print(f"sqrt(2) ~= {sqrt(2.0)}")
    return 0
